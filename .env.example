# EasyImporter 环境变量。复制为 .env 后填写，.env 不提交到代码库。

# 32 字节随机值的 base64：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 丢失后已登记的数据源密码无法解密，务必备份。
EI_SECRET_KEY=

# 首次启动时初始管理员 admin 的密码，首次登录后强制修改。
EI_ADMIN_INIT_PASSWORD=change-me-please

# 内置元数据库的密码（使用外部达梦或 MySQL 时可留空）。
POSTGRES_PASSWORD=change-me-please

# 元数据库连接。使用外部库时改成对应地址，例如 dm+dmPython://user:pass@host:5236
EI_DATABASE_URL=postgresql+psycopg://ei:${POSTGRES_PASSWORD}@db:5432/easyimporter

# 数据源主机白名单，逗号分隔，支持 CIDR。生产环境应当配置，空表示不限制。
EI_DATASOURCE_ALLOWED_HOSTS=

# 启用 HTTPS 后改为 true。
EI_COOKIE_SECURE=false

EI_UPLOAD_DIR=/data/uploads
EI_UPLOAD_MAX_MB=20
EI_ROWS_MAX_MB=200
EI_UPLOAD_RETENTION_DAYS=90
