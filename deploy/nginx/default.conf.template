server {
    listen 80;
    # 需同时容纳原始文件和 gzip 后的规范行。
    client_max_body_size ${EI_BODY_MAX_MB}m;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # $forwarded_proto 由 forwarded-proto.conf.template 的 map 定义：
        # 有上游（Medusa Nginx）传来的 X-Forwarded-Proto 时透传，否则用本层 $scheme。
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # SPA 回退。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
